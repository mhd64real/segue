# Copy to .env.local and fill in. The app builds and runs with none of these set; each
# feature stays off until its variables are present.

# Supabase (Project Settings > API Keys)
# Project URL, for example https://tzkvqtcczbwioevojejm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, used by the browser and cookie session clients for sign in only
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key, server only. Bypasses RLS. Never expose it to the browser.
SUPABASE_SECRET_KEY=

# The only Google account allowed to sign in
ALLOWED_EMAIL=

# Google Cloud OAuth web client (the same values go into the Supabase Google provider)
# Ends with .apps.googleusercontent.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Pub/Sub topic Gmail publishes to, in the form projects/<project id>/topics/<topic name>
GOOGLE_PUBSUB_TOPIC=

# Pub/Sub push subscription authentication
# Audience set on the push subscription
PUBSUB_PUSH_AUDIENCE=
# Service account email the push subscription signs its tokens with
PUBSUB_PUSH_SERVICE_ACCOUNT=

# 32 random bytes as base64, encrypts the stored Google refresh token. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Bearer secret Vercel cron sends to /api/cron/daily, at least 16 characters. Generate with: openssl rand -hex 32
CRON_SECRET=

# Anthropic API key
ANTHROPIC_API_KEY=
# Model for every step. Defaults to claude-opus-5 when empty.
LLM_MODEL=
# Optional cheaper model for the classify step, for example claude-haiku-4-5. Defaults to LLM_MODEL.
LLM_MODEL_CLASSIFY=
